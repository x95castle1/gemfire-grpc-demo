# Licensed Broadcom artifacts — never commit
gemfire-extensions/*
!gemfire-extensions/README.md

# Proto copied in from gemfire-extensions/ at build time
**/src/main/proto/gemfire/
# Go stubs generated from it (grpc-client-go/generate.sh)
**/grpc-client-go/gen/

# Build outputs
**/build/
**/.gradle/
**/out/
*.class

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Generated certs / local overrides
**/certs/generated/
# Demo certificates made at startup (06-tls and later): keys, never commit
**/certs/
*.local.env

# Load-test output (make select-load-test)
load-testing/results/*
!load-testing/results/.gitkeep
