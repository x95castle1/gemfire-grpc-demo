# ---------------------------------------------------------------------------
# 01-crud-basics configuration
# ---------------------------------------------------------------------------

# GemFire image (10.3.2+ is required by GemFire for gRPC 1.0).
# Alternative: registry.packages.broadcom.com/pivotal-gemfire/vmware-gemfire:10.3.2-jdk17
GEMFIRE_IMAGE=gemfire/gemfire:10.3.2-jdk17

# Folder holding the licensed gRPC extension + gemfire.proto (see ../vendor/README.md).
# Point this somewhere else if you copy this example out of the repo.
VENDOR_DIR=../vendor
GRPC_EXTENSION_FILE=gemfire-for-grpc-1.0.0.gfm

# Host ports (offset per example so several examples can run side by side).
GRAFANA_PORT=3001
PROMETHEUS_PORT=9001

# ---------------------------------------------------------------------------
# Client workload
# ---------------------------------------------------------------------------
# demo  = narrated walkthrough with assertions, then exit (0 = pass)
# bench = load loop for BENCH_DURATION exporting metrics
# all   = demo, then bench
MODE=all
BENCH_DURATION=10m
# Worker threads per client
CONCURRENCY=4
# Target ops/sec per client (0 = unlimited / closed loop). A fixed rate keeps the
# native vs gRPC latency comparison fair because neither client starves the other.
TARGET_RATE=1000
# Number of distinct keys each client cycles through
KEY_SPACE=10000
# Size of the byte[] value written by put-style ops
PAYLOAD_BYTES=1024
