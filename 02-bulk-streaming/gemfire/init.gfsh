# Runs once (gfsh-init service) after the locator and both servers are healthy.
connect --locator=locator[10334]

# One bulk region per client, so KeySetStream / keySetOnServer and entry counts are exact
# while both clients are load tested at the same time.
create region --name=bulk-grpc --type=PARTITION --if-not-exists
create region --name=bulk-native --type=PARTITION --if-not-exists
# One demo region per client so demo-mode assertions (e.g. EntryCount) are exact.
create region --name=demo-grpc --type=PARTITION --if-not-exists
create region --name=demo-native --type=PARTITION --if-not-exists

# Show that the gRPC extension is loaded on every member.
describe member --name=locator --extensions
describe member --name=server1 --extensions
describe member --name=server2 --extensions
list regions
