  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**05 \u00b7 xDS discovery: balanced vs not balanced.** The grpc-go client reaches the same cluster two ways. **direct** dials `dns:///server1:50051` (as in 01\u201304), so every call lands on server1. **xds** dials `xds:///gemfire_grpc`: the locator tells it which servers exist and it round-robins across them. Fill the panels with `make select-load-test EX=05 SCRIPT=xds/balance` (both channels, 1 minute), or `SCRIPT=xds/failover` to also stop server1 at 40 s and start it at 80 s (annotated)."
      },
      "transparent": true
    },
    {
      "type": "row",
      "title": "Balanced vs not balanced: which server answered each call",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "id": 3,
      "title": "direct: share of calls per server",
      "description": "Not balanced: DNS gives one address, so every call goes to server1. Over the whole time range, from the client's interceptor (demo_calls_total), so a failover in the range shows up as \"none\" (calls that reached no server). Narrow the range to one run to see just that run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (server) (increase(demo_calls_total{channel=\"direct\"}[$__range])) / scalar(sum(increase(demo_calls_total{channel=\"direct\"}[$__range])))",
          "legendFormat": "{{server}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^server1( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^server2( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d55181"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^none( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e5484d"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 22
        },
        "minVizHeight": 16,
        "maxVizHeight": 28,
        "reduceOptions": {
