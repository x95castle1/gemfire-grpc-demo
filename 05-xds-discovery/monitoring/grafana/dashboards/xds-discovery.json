  "title": "05 \u00b7 xDS discovery: balanced vs not balanced",
  "tags": [
    "gemfire",
    "grpc",
    "05-xds-discovery"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
