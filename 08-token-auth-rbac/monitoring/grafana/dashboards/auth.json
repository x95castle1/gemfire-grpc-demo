    "list": [
      {
        "name": "run",
        "label": "load run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_http_reqs_total, run)",
          "refId": "run"
        },
        "definition": "label_values(k6_http_reqs_total, run)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 2,
