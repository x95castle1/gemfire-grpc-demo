  "title": "08 \u00b7 Tokens and permissions",
  "tags": [
    "gemfire",
    "grpc",
    "08-token-auth-rbac"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
