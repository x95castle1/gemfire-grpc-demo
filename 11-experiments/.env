# ---------------------------------------------------------------------------
# 11-experiments configuration
# ---------------------------------------------------------------------------

# GemFire image (10.3.2+ is required by GemFire for gRPC 1.0).
# Alternative: registry.packages.broadcom.com/pivotal-gemfire/vmware-gemfire:10.3.2-jdk17
GEMFIRE_IMAGE=gemfire/gemfire:10.3.2-jdk17

# Folder holding the licensed gRPC extension + gemfire.proto (see ../gemfire-extensions/README.md).
# Point this somewhere else if you copy this example out of the repo.
GEMFIRE_EXTENSIONS_DIR=../gemfire-extensions
GRPC_EXTENSION_FILE=gemfire-for-grpc-1.0.0.gfm

# Host ports. Every example offsets them by its number, so several can run side by side:
#   Grafana 30NN · Prometheus 90NN · native-java client 82NN · grpc-go client 83NN
GRAFANA_PORT=3011
PROMETHEUS_PORT=9011
NATIVE_CLIENT_PORT=8211
GRPC_GO_CLIENT_PORT=8311

# ---------------------------------------------------------------------------
# Client services (load comes from k6: `make select-load-test`, see ../load-testing)
# ---------------------------------------------------------------------------
# Run the narrated demo when a client starts (it's also available at POST /demo)
DEMO_ON_START=true
# Default value size for writes (a request can override it with ?size=)
PAYLOAD_BYTES=1024
# Requests each client handles at once (Java: Tomcat's thread pool; Go: a semaphore).
# Same for every client so concurrency is identical.
HTTP_THREADS=64

# ---------------------------------------------------------------------------
# Server tuning (the worker-threads experiment)
# ---------------------------------------------------------------------------
# gemfire.grpc.worker-threads: the most threads the gRPC server runs calls on. Empty = the
# extension's default, 2 × the CPUs the server sees. worker-threads.sh sets it for each run.
GRPC_WORKER_THREADS=
