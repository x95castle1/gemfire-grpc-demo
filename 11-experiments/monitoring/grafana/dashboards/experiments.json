    {
      "type": "timeseries",
      "id": 7,
      "title": "Forwarded by server1",
      "description": "Operations server1 had to send to server2, because server2 owns the key. Only the gRPC client causes this: native single-hop sends each key to its owner. On crud-replicate both lines drop to zero for Gets: server1 holds every key.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gemfire_GetMessagesSent{node=\"server1\"}[1m]))",
          "legendFormat": "Gets forwarded (GetMessage)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gemfire_putRemoteCompleted{node=\"server1\", exported_instance=\"/crud-partition\"}[1m]))",
          "legendFormat": "Puts forwarded (putRemoteCompleted)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
