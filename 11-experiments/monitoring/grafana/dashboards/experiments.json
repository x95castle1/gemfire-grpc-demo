{
  "uid": "experiments",
  "title": "11 \u00b7 Experiments: what drives the gap between native and gRPC",
  "tags": [
    "gemfire",
    "grpc",
    "11-experiments"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "load run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_http_reqs_total, run)",
          "refId": "run"
        },
        "definition": "label_values(k6_http_reqs_total, run)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Load tests",
        "enable": true,
        "iconColor": "rgba(150, 150, 150, 0.6)",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "load-test"
          ],
          "limit": 100,
          "matchAny": false
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**11 \u00b7 Experiments: what drives the gap between native and gRPC.** native-java (single-hop, straight to the server that owns each key) and grpc-go (everything to server1) run the same load. Each experiment is a `make select-load-test EX=11 SCRIPT=experiments/\u2026` run whose steps run one after another, so its steps show up as plateaus over time; the load-test annotations name each run. `worker-threads.sh` restarts the servers between its runs (watch **members up**). Narrow the time range to one run to read it."
      },
      "transparent": true
    },
    {
      "type": "row",
      "title": "What the clients see: calls/s and GemFire call time, by client and region",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Calls/s by client and region",
      "description": "Completed /crud calls per second, from each client's own histogram. One client runs at a time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client, region) (rate(demo_op_latency_seconds_count{region=~\"crud-.*\"}[30s])) > 0",
          "legendFormat": "{{client}} \u00b7 {{region}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 60000,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none",
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^native-java \u00b7 crud-partition( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^native-java \u00b7 crud-replicate( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8fbbf0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^grpc-go \u00b7 crud-partition( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^grpc-go \u00b7 crud-replicate( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#7fd1b3"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
